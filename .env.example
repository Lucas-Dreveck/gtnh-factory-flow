NEXT_PUBLIC_GTNH_DATASET_MANIFEST_URL=/datasets/gtnh/datasets.manifest.json
# Optional: proxy dataset files and /api/datasets to another deployed app.
# GTNH_DATASET_BACKEND_URL=

# Private instance storage. Accounts, sessions and the design library (with its
# revision history) live in one SQLite file under this directory.
# GTNH_DATA_DIR=./var

# Set to 1 when the app is served over HTTPS (for example `tailscale serve`), so
# the session cookie is marked Secure. 0 forces it off.
# GTNH_COOKIE_SECURE=1

# Set to 1 only behind a reverse proxy you control: sign-in throttling then
# keys on X-Forwarded-For instead of one shared address.
# GTNH_TRUST_PROXY=0

# Largest plan the library accepts, in bytes (default 33554432 = 32 MB).
# GTNH_PLAN_MAX_BYTES=33554432

# Only answer for these Host headers (comma list, e.g. planner.tail1234.ts.net). Unset = any.
# GTNH_ALLOWED_HOSTS=

# Consistent database copies to <data dir>/backups: every N hours (0 = off), keep M.
# GTNH_BACKUP_HOURS=24
# GTNH_BACKUP_KEEP=14
